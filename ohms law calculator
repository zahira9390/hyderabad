elif choice == 2:
    V = float(input("Enter Voltage (V): "))
    R = float(input("Enter Resistance (Ω): "))
    I = V / R
    print("Current =", I, "A")

elif choice == 3:
    V = float(input("Enter Voltage (V): "))
