import java.util.Scanner;

public class OhmsLawCalculator {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("Ohm's Law Calculator");
        System.out.println("1. Calculate Voltage");
        System.out.println("2. Calculate Current");
        System.out.println("3. Calculate Resistance");

        System.out.print("Enter your choice: ");
        int choice = sc.nextInt();

        if (choice == 1) {
            System.out.print("Enter Current (A): ");
            double I = sc.nextDouble();

            System.out.print("Enter Resistance (Ohm): ");
            double R = sc.nextDouble();

            double V = I * R;
            System.out.println("Voltage = " + V + " V");

        } else if (choice == 2) {
            System.out.print("Enter Voltage (V): ");
            double V = sc.nextDouble();

            System.out.print("Enter Resistance (Ohm): ");
            double R = sc.nextDouble();

            double I = V / R;
            System.out.println("Current = " + I + " A");

        } else if (choice == 3) {
            System.out.print("Enter Voltage (V): ");
            double V = sc.nextDouble();

            System.out.print("Enter Current (A): ");
            double I = sc.nextDouble();

            double R = V / I;
            System.out.println("Resistance = " + R + " Ohm");

        } else {
            System.out.println("Invalid choice");
        }

        sc.close();
    }
}
