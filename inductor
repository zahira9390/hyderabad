import java.util.Scanner;

public class InductorCalculator {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("=== Inductor Calculator ===");

        System.out.print("Enter voltage (V): ");
        double V = sc.nextDouble();

        System.out.print("Enter time change (seconds): ");
        double dt = sc.nextDouble();

        System.out.print("Enter current change (A): ");
        double di = sc.nextDouble();

        double L = (V * dt) / di;

        System.out.println("Inductance = " + L + " Henry");

        sc.close();
    }
}

V = 10 V, dt = 2 s, di = 4 A

L = (10 × 2) / 4 = 5 H

